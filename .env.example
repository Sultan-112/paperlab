# Copy to .env. Generate local passwords with scripts/init_env.py.
# Never commit .env or provide real brokerage execution credentials.
POSTGRES_PASSWORD=replace-with-random-local-password
GRAFANA_PASSWORD=replace-with-random-local-password
APP_TOKEN=replace-with-random-local-token
DATA_MODE=live
PUBLIC_DEMO=false
# Leave false unless redistribution permission is verified for every live feed.
PUBLIC_LIVE_DATA_ALLOWED=false
# Set only when using docker-compose.public.yml on a host with public DNS.
# PUBLIC_DOMAIN=demo.example.com
# Free no-key stock snapshots; larger watchlists rotate under a global request cap.
STOCK_POLL_SECONDS=15
SAUDI_POLL_SECONDS=60
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
US_STREAM_LIMIT=30
OLLAMA_MODEL=qwen2.5:1.5b
REPLAY_FILE=data/replay/demo.csv
KSA_CATALOG_FILE=data/imports/ksa.csv
